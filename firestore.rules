rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500));
    }

    function isValidUserProgress(data) {
      return data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.name is string && data.name.size() <= 100
        && data.xp is number && data.xp >= 0 && data.xp <= 1000000
        && data.completedLevels is list && data.completedLevels.size() <= 50
        && data.unlockedBadges is list && data.unlockedBadges.size() <= 50
        && (!('activeLevelId' in data) || (data.activeLevelId is string && data.activeLevelId.size() <= 64))
        && (!('examScore' in data) || (data.examScore is number))
        && (!('certifiedDate' in data) || (data.certifiedDate is string && data.certifiedDate.size() <= 64));
    }

    // User profile document
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserProfile(incoming());
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserProfile(incoming())
                    && incoming().uid == existing().uid;
      allow delete: if false;

      // User progress subcollection
      match /progress/{progressId} {
        allow get, list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
        allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserProgress(incoming());
        allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserProgress(incoming())
                      && incoming().userId == existing().userId;
        allow delete: if false;
      }
    }
  }
}
