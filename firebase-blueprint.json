{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "displayName"]
    },
    "UserProgress": {
      "title": "UserProgress",
      "description": "Progress of the student in Banya Master School",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "xp": { "type": "number" },
        "completedLevels": { "type": "array" },
        "unlockedBadges": { "type": "array" },
        "activeLevelId": { "type": "string", "maxLength": 64 },
        "examScore": { "type": "number" },
        "certifiedDate": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "name", "xp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document"
    },
    "/users/{userId}/progress/{progressId}": {
      "schema": "UserProgress",
      "description": "User learning progress, XP and certification"
    }
  }
}
